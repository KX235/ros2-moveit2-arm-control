    <limit lower="-3.14" upper="3.14" effort="5" velocity="1.0"/>
  </joint>
  <link name="link5">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.035 0.035 0.08"/></geometry>
      <material name="orange"><color rgba="1 0.4 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.035 0.035 0.08"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04"/>
      <mass value="0.3"/>
      <inertia ixx="0.00019" ixy="0" ixz="0" iyy="0.00019" iyz="0" izz="0.000061"/>
    </inertial>
  </link>

  <link name="link6">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry><box size="0.03 0.03 0.05"/></geometry>
      <material name="orange"><color rgba="1 0.4 0.1 1"/></material>
