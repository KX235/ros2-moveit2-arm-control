<?xml version="1.0"?>
<robot name="arm">

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><cylinder length="0.06" radius="0.10"/></geometry>
      <material name="grey"><color rgba="0.6 0.6 0.6 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry><cylinder length="0.06" radius="0.10"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.03"/>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.02"/>
    </inertial>
  </link>

  <link name="link1">
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.30"/></geometry>
      <material name="orange"><color rgba="1 0.4 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.30"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.15"/>
      <mass value="1.0"/>
      <inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <link name="link2">
    <visual>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.25"/></geometry>
      <material name="orange"><color rgba="1 0.4 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.125" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 0.25"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.125"/>
      <mass value="0.8"/>
      <inertia ixx="0.0055" ixy="0" ixz="0" iyy="0.0055" iyz="0" izz="0.0006"/>
    </inertial>
  </link>

  <link name="link3">
    <visual>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.20"/></geometry>
      <material name="orange"><color rgba="1 0.4 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.20"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.10"/>
      <mass value="0.6"/>
      <inertia ixx="0.0021" ixy="0" ixz="0" iyy="0.0021" iyz="0" izz="0.00025"/>
    </inertial>
  </link>

  <link name="link4">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.12"/></geometry>
      <material name="orange"><color rgba="1 0.4 0.1 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 0.12"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.06"/>
      <mass value="0.4"/>
      <inertia ixx="0.000533" ixy="0" ixz="0" iyy="0.000533" iyz="0" izz="0.000107"/>
    </inertial>
  </link>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.06" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
  </joint>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.30" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
  </joint>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
  </joint>

  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 0.20" rpy="0 0 0"/>
