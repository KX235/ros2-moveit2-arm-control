<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="gripper_base_link">
    <visual>
      <origin xyz="0 0 ${gripper_plate_z/2}" rpy="0 0 0"/>
      <geometry><box size="${gripper_plate_x} ${gripper_plate_y} ${gripper_plate_z}"/></geometry>
      <material name="dark_green"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${gripper_plate_z/2}" rpy="0 0 0"/>
      <geometry><box size="${gripper_plate_x} ${gripper_plate_y} ${gripper_plate_z}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${gripper_plate_z/2}"/>
      <mass value="0.15"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.000505" iyz="0" izz="0.000545"/>
    </inertial>
  </link>

  <link name="gripper_left_finger_link">
    <visual>
      <origin xyz="0 0 ${gripper_finger_z/2}" rpy="0 0 0"/>
      <geometry><box size="${gripper_finger_x} ${gripper_finger_y} ${gripper_finger_z}"/></geometry>
      <material name="light_green"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${gripper_finger_z/2}" rpy="0 0 0"/>
      <geometry><box size="${gripper_finger_x} ${gripper_finger_y} ${gripper_finger_z}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${gripper_finger_z/2}"/>
      <mass value="0.05"/>
      <inertia ixx="0.0000417" ixy="0" ixz="0" iyy="0.0000283" iyz="0" izz="0.0000167"/>
    </inertial>
  </link>

  <link name="gripper_right_finger_link">
    <visual>
      <origin xyz="0 0 ${gripper_finger_z/2}" rpy="0 0 0"/>
      <geometry><box size="${gripper_finger_x} ${gripper_finger_y} ${gripper_finger_z}"/></geometry>
      <material name="light_green"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${gripper_finger_z/2}" rpy="0 0 0"/>
      <geometry><box size="${gripper_finger_x} ${gripper_finger_y} ${gripper_finger_z}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${gripper_finger_z/2}"/>
      <mass value="0.05"/>
      <inertia ixx="0.0000417" ixy="0" ixz="0" iyy="0.0000283" iyz="0" izz="0.0000167"/>
    </inertial>
  </link>

  <joint name="gripper_left_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="gripper_left_finger_link"/>
    <origin xyz="-0.07 0 ${gripper_plate_z}" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit effort="1000.0" velocity="1.0" lower="0.0" upper="${gripper_stroke}"/>
  </joint>

  <joint name="gripper_right_finger_joint" type="prismatic">
    <parent link="gripper_base_link"/>
    <child link="gripper_right_finger_link"/>
    <origin xyz="0.07 0 ${gripper_plate_z}" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <mimic joint="gripper_left_finger_joint" multiplier="-1.0"/>
    <limit effort="1000.0" velocity="1.0" lower="-${gripper_stroke}" upper="0.0"/>
  </joint>

</robot>
