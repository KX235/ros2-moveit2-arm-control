<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_h/2}" rpy="0 0 0"/>
      <geometry><cylinder length="${base_h}" radius="${base_r}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_h/2}" rpy="0 0 0"/>
      <geometry><cylinder length="${base_h}" radius="${base_r}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${base_h/2}"/>
      <mass value="2.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.02"/>
    </inertial>
  </link>

  <link name="link1">
    <visual>
      <origin xyz="0 0 ${l1/2}" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 ${l1}"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${l1/2}" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 ${l1}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${l1/2}"/>
      <mass value="1.0"/>
      <inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <link name="link2">
    <visual>
      <origin xyz="0 0 ${l2/2}" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 ${l2}"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${l2/2}" rpy="0 0 0"/>
      <geometry><box size="0.06 0.06 ${l2}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${l2/2}"/>
      <mass value="0.8"/>
      <inertia ixx="0.0055" ixy="0" ixz="0" iyy="0.0055" iyz="0" izz="0.0006"/>
    </inertial>
  </link>

  <link name="link3">
    <visual>
      <origin xyz="0 0 ${l3/2}" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 ${l3}"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${l3/2}" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 ${l3}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${l3/2}"/>
      <mass value="0.6"/>
      <inertia ixx="0.0021" ixy="0" ixz="0" iyy="0.0021" iyz="0" izz="0.00025"/>
    </inertial>
  </link>

  <link name="link4">
    <visual>
      <origin xyz="0 0 ${l4/2}" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 ${l4}"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${l4/2}" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 ${l4}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${l4/2}"/>
      <mass value="0.4"/>
      <inertia ixx="0.000533" ixy="0" ixz="0" iyy="0.000533" iyz="0" izz="0.000107"/>
    </inertial>
  </link>

  <link name="link5">
    <visual>
      <origin xyz="0 0 ${l5/2}" rpy="0 0 0"/>
      <geometry><box size="0.035 0.035 ${l5}"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${l5/2}" rpy="0 0 0"/>
      <geometry><box size="0.035 0.035 ${l5}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${l5/2}"/>
      <mass value="0.3"/>
      <inertia ixx="0.00019" ixy="0" ixz="0" iyy="0.00019" iyz="0" izz="0.000061"/>
    </inertial>
  </link>

  <link name="link6">
    <visual>
      <origin xyz="0 0 ${l6/2}" rpy="0 0 0"/>
      <geometry><box size="0.03 0.03 ${l6}"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${l6/2}" rpy="0 0 0"/>
      <geometry><box size="0.03 0.03 ${l6}"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${l6/2}"/>
      <mass value="0.2"/>
      <inertia ixx="0.0000567" ixy="0" ixz="0" iyy="0.0000567" iyz="0" izz="0.00003"/>
    </inertial>
  </link>

  <link name="tool_link"/>

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 ${base_h}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="10" velocity="1.0"/>
  </joint>

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 ${l1}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" effort="10" velocity="1.0"/>
  </joint>

  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 ${l2}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" effort="10" velocity="1.0"/>
  </joint>

  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 ${l3}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="5" velocity="1.0"/>
  </joint>

  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 ${l4}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="3" velocity="1.0"/>
  </joint>

  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0 0 ${l5}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="3" velocity="1.0"/>
  </joint>

  <joint name="hand_tool_joint" type="fixed">
    <parent link="link6"/>
    <child link="tool_link"/>
    <origin xyz="0 0 ${l6}" rpy="0 0 0"/>
  </joint>

</robot>
